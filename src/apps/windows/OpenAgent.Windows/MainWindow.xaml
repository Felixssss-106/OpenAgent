<Window
    x:Class="OpenAgent.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenAgent">

    <Grid Background="{ThemeResource BgCanvasBrush}">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            Background="Transparent"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneHeader>
                <!-- Doubles as the window drag region (MainWindow.SetTitleBar). -->
                <Grid
                    x:Name="AppTitleBar"
                    Height="48"
                    Margin="16,8,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The actual brand mark rather than a stock contact glyph;
                         Assets/tray.png is the same ring the installer .ico and the
                         Android launcher icons are generated from. -->
                    <Image
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Source="ms-appx:///Assets/tray.png"
                        Stretch="Uniform" />
                    <TextBlock
                        Grid.Column="1"
                        Text="OpenAgent"
                        Style="{StaticResource TypeBody}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="状态" />

                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid>
                            <TextBlock Text="任务" VerticalAlignment="Center" />
                            <!-- Plain count, right-aligned: the design shows a quiet
                                 number here, not an attention badge. -->
                            <TextBlock
                                x:Name="TaskCount"
                                Text="0"
                                Visibility="Collapsed"
                                Style="{StaticResource TypeCaption}"
                                Foreground="{ThemeResource TextQuaternaryBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItem Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid>
                            <TextBlock Text="设备" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DeviceCount"
                                Text="0"
                                Visibility="Collapsed"
                                Style="{StaticResource TypeCaption}"
                                Foreground="{ThemeResource TextQuaternaryBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0" />
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="能力" />

                <NavigationViewItem Content="工具" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC7A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Provider" Tag="providers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="插件" Tag="plugins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A0;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <TextBlock
                    x:Name="VersionText"
                    Style="{StaticResource TypeCaption}"
                    Foreground="{ThemeResource TextQuaternaryBrush}"
                    Margin="16,0,16,16" />
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
