<!-- Component styles for the shell and every page. Colours, type and radii come
     from Tokens.xaml (generated); this file only composes them, so a change to
     the design system still lands in one place. Numbers are measured from the
     1440x900 artboards in design/pixso-final. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Group heading above a sidebar section: 11px semibold, wide tracking. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TypeMicroSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="110" />
        <Setter Property="Foreground" Value="{ThemeResource TextQuaternaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Sidebar search field. The template replaces the stock one because WinUI
         draws a 2px accent underline in the focused state, which the design does
         not have; the named parts are the ones TextBox drives itself. -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border
                            x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Capsule36}" />
                        <Grid Padding="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xE721;"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextQuaternaryBrush}" />

                            <Grid Grid.Column="1" Margin="8,0,8,0">
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="0"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                                <ContentPresenter
                                    x:Name="PlaceholderTextContentPresenter"
                                    Content="{TemplateBinding PlaceholderText}"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Foreground="{ThemeResource TextQuaternaryBrush}" />
                            </Grid>

                            <TextBlock
                                Grid.Column="2"
                                Text="Ctrl K"
                                FontSize="{StaticResource TypeMicroSize}"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextQuaternaryBrush}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The command input inside the composer capsule. Same reason as SearchBox:
         the stock template animates a 2px accent underline in the focused state,
         which the artboards do not have. -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                        <ContentPresenter
                            x:Name="PlaceholderTextContentPresenter"
                            Content="{TemplateBinding PlaceholderText}"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Foreground="{ThemeResource TextQuaternaryBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every page shares the same content column. It is 1008px wide on the
         1440px artboard — which is what puts content on the x=336 baseline — but
         it must shrink with a narrower window instead of overflowing under the
         sidebar, so the width is a maximum, not a fixed size. -->
    <Style x:Key="ContentColumn" TargetType="FrameworkElement">
        <Setter Property="MaxWidth" Value="1008" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Secondary pages sit on a hairline under the caption bar; the start,
         conversation and approval screens do not. -->
    <Style x:Key="PageShell" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgCanvasBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <!-- 96px of inset on each side of the 1200px main area is what makes the
             content column 1008 wide and start at x=336 on the artboard. -->
        <Setter Property="Padding" Value="96,24" />
    </Style>

    <!-- Row list inside a card. The stock item container is replaced: its hover
         and selected fills are not in the artboards, and its own separators fight
         the card's. The -1 top padding pulls the first row's hairline under the
         card border so the two do not stack into a double line. -->
    <Style x:Key="RowList" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,-1,0,0" />
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="0,1,0,0">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

    <Style x:Key="HairLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

    <!-- Inset grouped list: one card per section, rows divided by hairlines that
         run the full card width, 28px corners so a 24px pill inside still obeys
         the inner-radius-never-exceeds-outer rule. -->
    <Style x:Key="ListCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Margin" Value="0,20,0,0" />
    </Style>

    <!-- Artboards 15 and 18 leave 25px between a group heading's ink and the card
         under it, which is a Margin="0,22,0,0" on that card once the heading's own
         line box is counted; the 8px this used to carry measured 11. -->
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TypeMicroSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="110" />
        <Setter Property="Foreground" Value="{ThemeResource TextQuaternaryBrush}" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

    <Style x:Key="DataRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="DataRowFirst" TargetType="Border" BasedOn="{StaticResource DataRow}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 8px status dot, the leading marker of every list row. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="RowNote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TypeCaptionSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- 24px pill used for risk and status values at the trailing edge of a row. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="{StaticResource Capsule24}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource BgInsetBrush}" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource TypeMicroSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="RowChevron" TargetType="FontIcon">
        <Setter Property="Glyph" Value="&#xE76C;" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextQuaternaryBrush}" />
    </Style>

    <!-- Buttons. Each is a capsule whose radius is half its height, and none of
         them keep the stock template: WinUI's default button paints a 1px border
         and a grey hover fill, and the artboards show neither. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource Capsule44}" />
        <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource TypeBodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource Capsule44}">
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuietPillButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="BareButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

</ResourceDictionary>
