<Window
    x:Class="OpenAgent.Windows.CommandCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ScrimBrush}"
        Loaded="RootGrid_Loaded">
        <Border
            x:Name="Panel"
            Width="680"
            MinHeight="220"
            MaxHeight="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource BgRaisedBrush}"
            BorderBrush="{ThemeResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="0.97" ScaleY="0.97" />
            </Border.RenderTransform>

            <!-- Open animation is built in code: a Storyboard declared inside
                 Border.Resources cannot reliably resolve its TargetName. -->
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Input row -->
                <Grid Grid.Row="0" Padding="24,20,20,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE8BD;"
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextBrush}"
                        VerticalAlignment="Center" />

                    <TextBox
                        x:Name="InputBox"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        PlaceholderText="让 Agent 做点什么…"
                        VerticalAlignment="Center"
                        KeyDown="InputBox_KeyDown" />

                    <TextBlock
                        Grid.Column="2"
                        Text="Esc 关闭"
                        Style="{StaticResource TypeCaption}"
                        Foreground="{ThemeResource TextQuaternaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>

                <Border
                    Grid.Row="1"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0" />

                <!-- Steps / results -->
                <ScrollViewer Grid.Row="2" Padding="24,16" MaxHeight="360">
                    <StackPanel x:Name="StepList" Spacing="10">
                        <TextBlock
                            x:Name="HintText"
                            Text="输入指令，回车发送给本地 Agent。高风险操作会先请求批准。"
                            Style="{StaticResource TypeCaption}"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Approval card: one row of its own, shown only when the
                     permission engine asks for confirmation. -->
                <Border
                    x:Name="ApprovalCard"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Margin="24,0,24,12"
                    Padding="16"
                    Background="{ThemeResource BgSunkenBrush}"
                    BorderBrush="{ThemeResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ApprovalCardScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ApprovalTitle"
                                Grid.Column="0"
                                Text="需要批准"
                                Style="{StaticResource TypeBody}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="ApprovalRiskChip"
                                Grid.Column="1"
                                Padding="10,4"
                                CornerRadius="{StaticResource RadiusPill}"
                                Background="{ThemeResource BgInsetBrush}"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="ApprovalRiskText"
                                    Text="中风险"
                                    Style="{StaticResource TypeMicro}"
                                    Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock
                            x:Name="ApprovalArgsText"
                            Grid.Row="1"
                            Style="{StaticResource TypeCode}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />

                        <TextBlock
                            x:Name="ApprovalNoteText"
                            Grid.Row="2"
                            Style="{StaticResource TypeCaption}"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="ApprovalCountdown"
                            Grid.Row="3"
                            Style="{StaticResource TypeCaption}"
                            Foreground="{ThemeResource TextTertiaryBrush}" />

                        <StackPanel
                            Grid.Row="4"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                            <Button
                                x:Name="RejectButton"
                                Content="拒绝"
                                CornerRadius="{StaticResource RadiusPill}"
                                Padding="16,6"
                                Click="RejectButton_Click" />
                            <Button
                                x:Name="ApproveButton"
                                Content="批准"
                                Background="{ThemeResource AccentBrush}"
                                Foreground="{ThemeResource OnAccentBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource RadiusPill}"
                                Padding="16,6"
                                Click="ApproveButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border
                    Grid.Row="4"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="OpenAgent Native · 本地优先"
                            Style="{StaticResource TypeCaption}"
                            Foreground="{ThemeResource TextQuaternaryBrush}"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            x:Name="SendButton"
                            Content="发送"
                            Background="{ThemeResource AccentBrush}"
                            Foreground="{ThemeResource OnAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="16,6"
                            Click="SendButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
