<Window
    x:Class="OpenAgent.Windows.CommandCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ScrimBrush}"
        Loaded="RootGrid_Loaded">
        <Border
            x:Name="Panel"
            Width="680"
            MinHeight="220"
            MaxHeight="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource BgRaisedBrush}"
            BorderBrush="{ThemeResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="0.96" ScaleY="0.96" />
            </Border.RenderTransform>

            <!-- Open animation is built in code: a Storyboard declared inside
                 Border.Resources cannot reliably resolve its TargetName. -->
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Input row -->
                <Grid Grid.Row="0" Padding="24,20,20,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Glyph="&#xE8BD;"
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextBrush}"
                        VerticalAlignment="Center" />

                    <TextBox
                        x:Name="InputBox"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        PlaceholderText="让 Agent 做点什么…"
                        VerticalAlignment="Center"
                        KeyDown="InputBox_KeyDown" />

                    <TextBlock
                        Grid.Column="2"
                        Text="Esc 关闭"
                        Style="{StaticResource TypeCaption}"
                        Foreground="{ThemeResource TextQuaternaryBrush}"
                        VerticalAlignment="Center" />
                </Grid>

                <Border
                    Grid.Row="1"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0" />

                <!-- Steps / results -->
                <ScrollViewer Grid.Row="2" Padding="24,16" MaxHeight="360">
                    <StackPanel x:Name="StepList" Spacing="10">
                        <TextBlock
                            x:Name="HintText"
                            Text="输入指令，回车发送给本地 Agent。高风险操作会先请求批准。"
                            Style="{StaticResource TypeCaption}"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border
                    Grid.Row="3"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="OpenAgent Native · 本地优先"
                            Style="{StaticResource TypeCaption}"
                            Foreground="{ThemeResource TextQuaternaryBrush}"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            x:Name="SendButton"
                            Content="发送"
                            Background="{ThemeResource AccentBrush}"
                            Foreground="{ThemeResource OnAccentBrush}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="16,6"
                            Click="SendButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
