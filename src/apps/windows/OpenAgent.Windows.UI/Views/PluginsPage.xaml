<Page
    x:Class="OpenAgent.Windows.UI.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource PageShell}">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,0,0,24">
            <Grid Style="{StaticResource ContentColumn}">
                <StackPanel>
                <TextBlock
                    Text="插件"
                    Style="{StaticResource TypePageTitle}" />
                <TextBlock
                    Text="插件加载器尚未实现，因此这里没有可列出的插件。"
                    Style="{StaticResource PageSubtitle}" />
                <Border Style="{StaticResource HairLine}" />

                <Border
                    Style="{StaticResource ListCard}"
                    Padding="24"
                    Margin="0,20,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="0 个已安装"
                            FontSize="{StaticResource TypeHeadingSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="插件以独立进程运行，崩溃不会带崩主程序。加载器与 manifest 校验完成后，已安装的插件会列在这里。"
                            Style="{StaticResource RowNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
