<Page
    x:Class="OpenAgent.Windows.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 起始页: greeting, one system-message capsule, one input bar. Nothing else —
         the artboards keep this screen deliberately empty (design/pixso-final/01,02). -->
    <Grid Background="{ThemeResource BgCanvasBrush}" Padding="96,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource ContentColumn}">
            <!-- The greeting sits two fifths of the way down the artboard: on the
                 900px frame that reads as 308px above it and 252px below, so the
                 space is split 55/45 and stays put at any window height instead
                 of being pinned to a pixel offset. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="55*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="45*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1">
                <!-- One line box per row of the artboard's 60px leading. The glyphs
                     sit where the font's own ascent puts them inside that box, which
                     is what reproduces the artboard's 16px inset from the box top. -->
                <TextBlock
                    x:Name="GreetingLine1"
                    Style="{StaticResource TypeHero}"
                    Height="60"
                    VerticalAlignment="Top" />
                <TextBlock
                    x:Name="GreetingLine2"
                    Style="{StaticResource TypeHero}"
                    Height="60"
                    VerticalAlignment="Top" />

                <Border
                    Height="40"
                    Margin="0,56,0,0"
                    Background="{ThemeResource BgSunkenBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Capsule40}"
                    Padding="14,0"
                    HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE946;"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextQuaternaryBrush}" />
                        <TextBlock
                            x:Name="ProviderReadyText"
                            Text="OpenAgent Native 已就绪"
                            FontSize="{StaticResource TypeCaptionSize}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            Text="&#x00B7;"
                            FontSize="{StaticResource TypeCaptionSize}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextQuaternaryBrush}" />
                        <TextBlock
                            x:Name="DeviceNameText"
                            FontSize="{StaticResource TypeCaptionSize}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            Text="&#x00B7;"
                            FontSize="{StaticResource TypeCaptionSize}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextQuaternaryBrush}" />
                        <TextBlock
                            x:Name="PermissionModeText"
                            Text="权限：请求批准"
                            FontSize="{StaticResource TypeCaptionSize}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource ContentColumn}" Margin="0,0,0,24">
            <Border
                Height="56"
                Background="{ThemeResource BgSurfaceBrush}"
                BorderBrush="{ThemeResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource Capsule56}"
                Padding="20,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="CommandInput"
                        Grid.Column="0"
                        Style="{StaticResource InputBox}"
                        PlaceholderText="输入指令…"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Grid.Column="1"
                        Text="Alt + Space"
                        FontSize="{StaticResource TypeCaptionSize}"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextQuaternaryBrush}" />

                    <Button
                        Grid.Column="2"
                        x:Name="SendButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="{ThemeResource AccentBrush}"
                        Foreground="{ThemeResource OnAccentBrush}"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Capsule32}"
                        Click="SendButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Capsule32}">
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <FontIcon Glyph="&#xE74A;" FontSize="14" Foreground="{ThemeResource OnAccentBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
