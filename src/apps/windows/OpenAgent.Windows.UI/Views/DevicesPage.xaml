<Page
    x:Class="OpenAgent.Windows.UI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenAgent.Windows.UI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource PageShell}">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,0,0,24">
            <Grid Style="{StaticResource ContentColumn}">
                <StackPanel>
                <TextBlock
                    Text="设备"
                    Style="{StaticResource TypePageTitle}" />
                <TextBlock
                    x:Name="StatsText"
                    Style="{StaticResource PageSubtitle}" />
                <Border Style="{StaticResource HairLine}" />

                <!-- Each device is its own card, not a row in one list: the
                     artboards give a device three lines of detail. -->
                <ListView
                    x:Name="DeviceList"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionMode="None"
                    Padding="0,20,0,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DeviceItem">
                            <Border
                                Background="{ThemeResource BgSurfaceBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLg}"
                                Padding="24"
                                Margin="0,0,0,20">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            FontSize="{StaticResource TypeHeadingSize}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock
                                            Text="·"
                                            FontSize="{StaticResource TypeHeadingSize}"
                                            Foreground="{ThemeResource TextQuaternaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Tag}"
                                            FontSize="{StaticResource TypeHeadingSize}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind SystemInfo}"
                                        Style="{StaticResource RowNote}" />
                                    <TextBlock
                                        Text="{x:Bind Metrics}"
                                        FontSize="{StaticResource TypeCaptionSize}"
                                        Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
