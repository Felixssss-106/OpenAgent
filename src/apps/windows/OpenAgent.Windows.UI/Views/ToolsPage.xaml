<Page
    x:Class="OpenAgent.Windows.UI.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenAgent.Windows.UI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource BgCanvasBrush}" Padding="{StaticResource ContentPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="工具"
            Style="{StaticResource TypeTitle}"
            Margin="0,0,0,8" />

        <TextBlock
            Grid.Row="1"
            x:Name="StatsText"
            Style="{StaticResource TypeCaption}"
            Foreground="{ThemeResource TextTertiaryBrush}"
            Margin="0,0,0,24" />

        <Border
            Grid.Row="2"
            BorderBrush="{ThemeResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Margin="0,0,0,16" />

        <ListView
            Grid.Row="3"
            x:Name="ToolList"
            Background="Transparent"
            BorderThickness="0"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ToolItem">
                    <Grid Padding="12,14" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="{ThemeResource BgInsetBrush}">
                            <FontIcon
                                Glyph="{x:Bind Glyph}"
                                FontSize="14"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource TypeBody}" />
                            <TextBlock
                                Text="{x:Bind Description}"
                                Style="{StaticResource TypeCaption}"
                                Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Background="{x:Bind RiskBackground}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="10,4"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind RiskLabel}"
                                Style="{StaticResource TypeMicro}"
                                Foreground="{x:Bind RiskForeground}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
