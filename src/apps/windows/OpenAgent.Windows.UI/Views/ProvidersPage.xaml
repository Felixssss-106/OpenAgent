<Page
    x:Class="OpenAgent.Windows.UI.Views.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenAgent.Windows.UI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource PageShell}">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,0,0,24">
            <Grid Style="{StaticResource ContentColumn}">
                <StackPanel>
                <TextBlock
                    Text="Provider"
                    Style="{StaticResource TypePageTitle}" />
                <TextBlock
                    x:Name="StatsText"
                    Style="{StaticResource PageSubtitle}" />
                <Border Style="{StaticResource HairLine}" />

                <Border Style="{StaticResource ListCard}">
                    <ListView
                        x:Name="ProviderList"
                        Style="{StaticResource RowList}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProviderItem">
                                <Grid
                                    Height="45"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse
                                        Grid.Column="0"
                                        Style="{StaticResource StatusDot}"
                                        Fill="{x:Bind StatusBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Name}"
                                        Style="{StaticResource RowTitle}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind StatusLabel}"
                                        FontSize="{StaticResource TypeCaptionSize}"
                                        VerticalAlignment="Center"
                                        Foreground="{x:Bind StatusTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
