<Page
    x:Class="OpenAgent.Windows.UI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenAgent.Windows.UI.Views"
    xmlns:controls="using:OpenAgent.Windows.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- The design's row pitch (42) includes the hairline that separates two
             rows, so the divider must not add to it: the negative bottom margin
             pulls the next row up onto the divider's own pixel. -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,0,0,-1" />
            <Setter Property="Background" Value="{ThemeResource BorderSubtleBrush}" />
        </Style>
    </Page.Resources>

    <Border Style="{StaticResource PageShell}">
        <ScrollViewer
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Padding="0,0,0,24">
            <Grid Style="{StaticResource ContentColumn}">
                <StackPanel>
                <TextBlock
                    Text="设置"
                    Style="{StaticResource TypePageTitle}" />
                <Border Style="{StaticResource HairLine}" />

                <TextBlock
                    Text="通用"
                    Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource ListCard}" Margin="0,22,0,0">
                    <StackPanel>
                        <controls:SettingRow
                            x:Name="StartupSetting"
                            Title="开机启动"
                            Value="已关闭"
                            Click="StartupSetting_Click" />
                        <Border Style="{StaticResource RowDivider}" />
                        <controls:SettingRow
                            Title="语言"
                            Value="简体中文" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="外观"
                    Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource ListCard}" Margin="0,22,0,0">
                    <StackPanel>
                        <controls:SettingRow
                            x:Name="ThemeSetting"
                            Title="主题"
                            Value="跟随系统"
                            Click="ThemeSetting_Click" />
                        <Border Style="{StaticResource RowDivider}" />
                        <controls:SettingRow
                            Title="界面密度"
                            Value="舒适" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="Agent"
                    Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource ListCard}" Margin="0,22,0,0">
                    <StackPanel>
                        <controls:SettingRow
                            x:Name="DefaultAgentSetting"
                            Title="默认 Agent"
                            Value="OpenAgent Native" />
                        <Border Style="{StaticResource RowDivider}" />
                        <controls:SettingRow
                            x:Name="PermissionSetting"
                            Title="权限模式"
                            Value="请求批准"
                            ValueForeground="{ThemeResource AccentBrush}"
                            Click="PermissionSetting_Click" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="网络"
                    Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource ListCard}" Margin="0,22,0,0">
                    <StackPanel>
                        <controls:SettingRow
                            Title="Relay"
                            Value="未启用" />
                        <Border Style="{StaticResource RowDivider}" />
                        <controls:SettingRow
                            Title="连接方式"
                            Value="直连 · 局域网" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
